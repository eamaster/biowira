{
  "ConnectionStrings": {
    "Postgres": "Host=#{DB_HOST}#;Database=#{DB_NAME}#;Username=#{DB_USER}#;Password='#{DB_PASSWORD}#';Ssl Mode=Require;Trust Server Certificate=true"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Tts": {
    "ElevenLabsApiKey": "#{TTS_ELEVENLABSAPIKEY}#",
    "DefaultVoice": "#{TTS_DEFAULTVOICE}#",
    "ModelId": "#{TTS_MODELID}#",
    "BaseUrl": "#{TTS_BASEURL}#"
  },
  "Gemini": {
    "ApiKey": "#{GEMINI_API_KEY}#"
  }
}
