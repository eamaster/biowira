# Copy this file to `.env` in the project root (`.env` is gitignored).
# Vite loads `.env` for both `npm run dev` and `npm run build`.

# Same-origin API prefix including version — no trailing slash.
# All backend endpoints live under /api/v1/ per the Swagger contract.
# Production: CloudFront routes https://biowira.dpdns.org/api/* to the API, so /api/v1/* resolves.
# Local dev: Vite proxies /api to the backend (see vite.config.ts), so /api/v1/* also resolves.
VITE_API_BASE_URL=/api/v1

# Optional: Override the base URL for the Open-Meteo weather forecast API.
# Defaults to https://api.open-meteo.com/v1 if not set.
# VITE_WEATHER_API_BASE_URL=https://api.open-meteo.com/v1

VITE_USE_MOCK=false
VITE_APP_VERSION=0.1.0
VITE_SESSION_ENABLED=true

# Mapbox (Discover map). CI: set VITE_MAPBOX_ACCESS_TOKEN in GitHub Actions secrets.
VITE_MAPBOX_ACCESS_TOKEN=

# ── Per-domain repository source overrides (optional) ─────────────────────────
# Each domain independently selects its data source: 'api' or 'mock'.
# Omit a var to use the built-in safe default (see src/app/config.ts).
# Invalid values are ignored and fall back to the safe default.
#
# Defaults are in src/app/config.ts (animals/session/profile/quizzes/funFacts → api; user → mock).
# Override per-domain when needed, e.g. VITE_REPO_USER=api after /api/user/* exists.
#
# VITE_REPO_ANIMALS=api
# VITE_REPO_QUIZZES=api
# VITE_REPO_SESSION=mock
# VITE_REPO_PROFILE=mock
# VITE_REPO_USER=mock
# VITE_REPO_FUN_FACTS=mock

# ── Narration source ───────────────────────────────────────────────────────────
# api     = BioWira backend ElevenLabs cached TTS endpoint /api/v1/tts/generate (default)
# browser = Web Speech API fallback (explicit dev-only override; set VITE_NARRATION_SOURCE=browser)
#
# IMPORTANT: ElevenLabs API keys must never be placed in the frontend.
# The frontend only calls the BioWira backend. The backend owns ElevenLabs credentials
# and the PostgreSQL TTS cache.
VITE_NARRATION_SOURCE=api
VITE_TTS_VOICE_ID=rCmVtv8cYU60uhlsOo1M
VITE_TTS_MODEL_ID=eleven_v3
VITE_TTS_SPEED=1
